<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Suimo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorEdgeEffect">@color/accent</item>
    </style>

    <style name="Text.Suimo.Hero" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Text.Suimo.Headline" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Suimo.Section" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Suimo.Tag" parent="">
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Suimo.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Text.Suimo.Caption" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Widget.Suimo.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.Suimo.InnerCard" parent="">
        <item name="android:background">@drawable/bg_card_inner</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.Suimo.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Widget.Suimo.PrimaryButton" parent="">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Suimo.GhostButton" parent="">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Suimo.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Suimo.LinkButton" parent="">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>
</resources>
